id = "org.startk.http-json"
title = "HTTP JSON"
label = "HTTP JSON"
icon = "check-square"
version = "0.1.0"
api = 2
entrypoint = "app/main.lua"

[capabilities]
storage_private = false
workspace_read = false
workspace_write = false
network = ["jsonplaceholder.typicode.com"]
clipboard = false
tool_run = []

[limits]
memory_mb = 16
storage_mb = 1
requests_in_flight = 4
