id = "org.startk.ipc-storage"
title = "StartK IPC Storage"
label = "Files + SQLite"
icon = "database"
version = "0.2.0"
api = 2
entrypoint = "app/main.lua"
[capabilities]
storage_private = true
workspace_read = false
workspace_write = false
network = []
clipboard = false
tool_run = []
[limits]
memory_mb = 16
storage_mb = 4
requests_in_flight = 4
