id = "org.startk.chess"
title = "Xadrez"
label = "Xadrez"
icon = "checkerboard"
version = "0.1.4"
api = 3
runtime = "rust"

[executables]
linux_x86_64 = "bin/chess-linux-x86_64"
kobo_armv7_musleabihf = "bin/chess-kobo-armv7-musleabihf"

[capabilities]
storage_private = true
workspace_read = false
workspace_write = false
network = []
clipboard = false
tool_run = []

[limits]
memory_mb = 16
storage_mb = 1
requests_in_flight = 4
